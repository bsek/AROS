# AROS .clangd configuration template
#
# Generated by scripts/generate_clangd.py -- edits to the generated .clangd
# are lost on regeneration; change this template instead.
#
# Flags mirror what the build actually uses; compare with the generated
# makefiles under ${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/.
#
# Substituted by the generator:
#   ${AROS_SOURCE_DIR} ${AROS_BUILD_DIR} ${AROS_TARGET_ARCH}
#   ${AROS_TARGET_TRIPLE} ${AROS_TARGET_CPU}

CompileFlags:
  # Flags the build passes that clangd cannot use or does not need.
  Remove:
    - "-mcmodel=large"
    - "-mno-red-zone"
    - "-mno-ms-bitfields"
    - "-fno-builtin-floor"
    - "-fno-ipa-cp*"
    - "-specs=*"

  Add:
    # Real target triple. This selects compiler/include/aros/${AROS_TARGET_CPU}
    # and the correct pointer/long widths in the AROS headers -- getting it
    # wrong silently gives every struct the wrong layout.
    - "--target=${AROS_TARGET_TRIPLE}"
    - "-std=gnu11"
    # Keep the host's /usr/include out of the way. clangd still uses its own
    # builtin headers (stdarg.h, stdint.h, ...) from its resource dir.
    - "-nostdlibinc"
    - "-ferror-limit=0"
    ${AROS_CPU_FLAGS}

    - "-D__AROS__"
    - "-DAROS_BUILD_TYPE=AROS_BUILD_TYPE_PERSONAL"
    - "-DCPU=\"${AROS_TARGET_CPU}\""

    # The edited file's own directory, matching -I$(srcdir) in the makefiles.
    - "-I."

    # Source tree headers before the installed copies, so go-to-definition
    # lands in git-tracked files.
    - "-I${AROS_SOURCE_DIR}/compiler/include"

    # Installed target headers. Everything genmodule generated (proto/,
    # defines/, inline/, clib/, hidd/, ...) exists only here.
    - "-isystem"
    - "${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/AROS/Developer/include"
    # The AROS cross compiler adds these two implicitly; plain clangd does not.
    - "-isystem"
    - "${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/AROS/Developer/include/aros/stdc"
    - "-isystem"
    - "${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/AROS/Developer/include/aros/posixc"

    # Generated aros/config.h et al.
    - "-I${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/config"
    - "-I${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/include"

---
# AHI: autotools subproject with its own generated config.h and a shared
# driver core in Drivers/Common.
If:
  # PathMatch in a project .clangd is relative to the .clangd file's directory.
  PathMatch: "(.*/)?workbench/devs/AHI/.*"
CompileFlags:
  Add:
    - "-I${AROS_SOURCE_DIR}/workbench/devs/AHI"
    - "-I${AROS_SOURCE_DIR}/workbench/devs/AHI/Drivers/Common"
    # generated config.h
    - "-I${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/workbench/devs/AHI"
    # generated ahi_sub protos/inlines
    - "-I${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/workbench/devs/AHI/Include/gcc"
    # normally -DDRIVER="\"<name>\"" per driver; a placeholder keeps
    # library.c/library.h parsing.
    - "-DDRIVER=\"driver.audio\""

---
# muimaster: classes/ include headers from the library root.
If:
  PathMatch: "(.*/)?workbench/libs/muimaster/.*"
CompileFlags:
  Add:
    - "-I${AROS_SOURCE_DIR}/workbench/libs/muimaster"
    - "-I${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/workbench/libs/muimaster/muimaster/include"

---
# Kernel / bootstrap sources: built with the ELF wrapper, not the AROS driver.
If:
  PathMatch: "${AROS_KERNEL_PATHMATCH}"
CompileFlags:
  Add:
    - "-D__ELF__"
    - "-I${AROS_SOURCE_DIR}/rom/kernel"
    ${AROS_KERNEL_INCLUDES}
    - "-I${AROS_BUILD_DIR}/bin/${AROS_TARGET_ARCH}/gen/rom/kernel"

---
Diagnostics:
  Suppress:
    - "unknown-pragmas"
    - "gnu-statement-expression"
    - "gnu-zero-variadic-macro-arguments"
    - "deprecated-declarations"
    - "pointer-sign"
    - "incompatible-pointer-types-discards-qualifiers"
    - "incompatible-library-redeclaration"
    - "int-conversion"
  ClangTidy:
    Add:
      - "bugprone-*"
      - "performance-*"
    Remove:
      - "bugprone-narrowing-conversions"
      - "bugprone-assignment-in-if-condition"
      - "bugprone-easily-swappable-parameters"
      - "performance-no-int-to-ptr"

Index:
  StandardLibrary: No
  Background: Build

Completion:
  AllScopes: Yes
