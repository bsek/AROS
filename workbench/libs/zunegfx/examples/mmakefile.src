#
# Makefile for zunegfx examples

include $(SRCDIR)/config/aros.cfg

FILES  := \
    demo_rect_locked \
    demo_rect_unlocked \
    demo_rect_aa_locked \
    demo_rect_aa_unlocked \
    demo_circle_locked \
    demo_circle_unlocked \
    demo_circle_aa_locked \
    demo_circle_aa_unlocked \
    demo_line_locked \
    demo_line_unlocked \
    demo_line_aa_locked \
    demo_line_aa_unlocked \
    demo_text_locked \
    demo_text_unlocked \
    demo_polyline_locked \
    demo_polyline_unlocked \
    demo_polygon_locked \
    demo_polygon_unlocked \
    demo_texture \
    demo_pixel \
    demo_clipping \
    demo_sync \
    demo_batch

#MM workbench-libs-zunegfx-examples : includes linklibs workbench-libs-zunegfx

TARGETDIR := $(AROSDIR)/Developer/Debug/Tests/Graphics/zunegfx

%build_progs mmake=workbench-libs-zunegfx-examples \
    files=$(FILES) targetdir=$(TARGETDIR) \
    uselibs="zunegfx muimaster mui GL"

#MM
workbench-libs-zunegfx-examples : $(TARGETDIR)/testimage.png

$(TARGETDIR)/testimage.png : $(SRCDIR)/$(CURDIR)/testimage.png
	%mkdir_q dir=$(TARGETDIR)
	$(CP) $< $@

%common
