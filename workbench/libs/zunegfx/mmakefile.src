#
#   Generate zunegfx.library - Simplified Implementation
#

include $(SRCDIR)/config/aros.cfg

# Function implementations (library functions with AROS_LH macros)
FUNCS :=

# Source files organized by module
CORE_FILES := \
        src/core/core_globals                    \
        src/core/zunecreaterendercontextforwindow \
        src/core/zunesettarget                   \
        src/core/zunedestroyrendercontext        \
        src/core/zuneclearrendercontext          \
        src/core/zunegetmasterglcontext          \
        src/core/zunecreaterendercontexta        \
        src/zunegfx_utils                        \
        src/zunegfx_fallback

TEXTURE_FILES := \
        src/texture/texture_globals                    \
        src/texture/zunecreatetexture                  \
        src/texture/zunecreatetexturefromdata           \
        src/texture/zunecreatetexturefromdrawingboard   \
        src/texture/zunecreatetexturefromdatatype       \
        src/texture/zunecreatetexturefromfile            \
        src/texture/zunedestroytexture                  \
        src/texture/zuneupdatetexturedata               \
        src/texture/zunelocktexturepixels               \
        src/texture/zuneunlocktexturepixels             \
        src/texture/zunegettexturepixel                 \
        src/texture/zunesettexturepixel                 \
        src/texture/zunedrawtexture                     \
        src/texture/zunedrawtexturescaled               \
        src/texture/zunedrawtextureregion               \
        src/texture/zunedrawtexturetinted               \
        src/texture/zunedrawtexturescaledtinted         \
        src/texture/zunedrawtextureregiontinted         \
        src/texture/zunedrawtexturetiled                \
        src/texture/zuneistexturevalid                  \
        src/texture/zunecreatetexturea

DRAWINGBOARD_FILES := \
        src/drawingboard/drawingboard_globals                    \
        src/drawingboard/zunecreatedrawingboardforrendercontext  \
        src/drawingboard/zunedestroydrawingboard                 \
        src/drawingboard/zunecleardrawingboard                   \
        src/drawingboard/zunelockdrawingboardpixels              \
        src/drawingboard/zuneunlockdrawingboardpixels            \
        src/drawingboard/zunegetpixel                            \
        src/drawingboard/zunesetpixel                            \
        src/drawingboard/zuneblit                                \
        src/drawingboard/zunepresent                             \
        src/drawingboard/zunecapture                             \
        src/drawingboard/zunesync                                \
        src/drawingboard/zunereload                              \
        src/drawingboard/zunecreatedrawingboarda

CLIPPING_FILES := \
        src/clipping/zunesetclipregion            \
        src/clipping/zuneclearclipregion           \
        src/clipping/zunecombineregions            \
        src/clipping/zunecreatecircleregion        \
        src/clipping/zunecreateroundedrectregion

BATCHING_FILES := \
        src/batching/batching_globals           \
        src/batching/zunebeginbatch             \
        src/batching/zuneendbatch               \
        src/batching/zuneflushbatch             \
        src/batching/zuneisbatchingenabled      \
        src/batching/zunegetbatchcount

DRAWING_FILES := \
        src/drawing/zunefillcircle              \
        src/drawing/zunedrawcircleoutline       \
        src/drawing/zunedrawline                \
        src/drawing/zunedrawcircleoutlinestyled \
        src/drawing/zunedrawlinestyled          \
        src/drawing/zunedrawpixel               \
        src/drawing/zunedrawpolyline            \
        src/drawing/zunedrawpolylinestyled      \
        src/drawing/zunefillpolygon

TEXT_FILES := \
        src/text/zunesetfont                    \
        src/text/zunetextlength                 \
        src/text/zunetextfit                    \
        src/text/zunedrawtext                   \
        src/text/zunedrawtextbg

RECTANGLE_FILES := \
        src/rectangle/zunefillrectangle                      \
        src/rectangle/zunefillrectanglerounded               \
        src/rectangle/zunedrawrectangleoutline                \
        src/rectangle/zunedrawrectangleroundedoutline         \
        src/rectangle/zunedrawrectangleoutlinestyled          \
        src/rectangle/zunedrawrectangleroundedoutlinestyled   \
        src/rectangle/zunedrawrectangleroundedstyled

ANTIALIASING_FILES := \
        src/antialiasing/antialiasing_globals                   \
        src/antialiasing/zunedrawcircleaa                       \
        src/antialiasing/zunefillcircleaa                       \
        src/antialiasing/zunedrawcircleoutlinestyledaa          \
        src/antialiasing/zunefillcirclestyledaa                 \
        src/antialiasing/zunesetantialiasingquality             \
        src/antialiasing/zunegetantialiasingquality             \
        src/antialiasing/zunefillrectangleroundedaa             \
        src/antialiasing/zunefillrectangleroundedstyledaa       \
        src/antialiasing/zunedrawrectangleroundedoutlinestyledaa \
        src/antialiasing/zunedrawrectangleroundedoutlineaa      \
        src/antialiasing/zunedrawlineaa                         \
        src/antialiasing/zunedrawlinestyledaa

BACKEND_FILES := \
        src/backends/backend_manager        \
        src/backends/cybergfx/cybergfx_backend \
        src/backends/cybergfx/cybergfx_antialiasing \
        src/backends/cybergfx/cybergfx_texture \
        src/backends/cybergfx/cybergfx_clipping \
        src/backends/cybergfx/rectangle/cybergfx_draw_rectangle \
        src/backends/cybergfx/rectangle/cybergfx_draw_rectangle_to_locked_board \
        src/backends/cybergfx/rectangle/cybergfx_draw_rectangle_to_raster_port \
        src/backends/cybergfx/rectangle/cybergfx_draw_rounded_rectangle_to_raster_port \
        src/backends/cybergfx/rectangle/cybergfx_draw_rounded_rectangle_to_locked_board \
        src/backends/cybergfx/rectangle/cybergfx_draw_rectangle_aa_drawingboard \
        src/backends/cybergfx/rectangle/cybergfx_draw_rectangle_aa_raster_port \
        src/backends/cybergfx/cybergfx_simd \
        src/backends/cybergfx/cybergfx_line \
        src/backends/cybergfx/cybergfx_circle \
        src/backends/cybergfx/cybergfx_brush_sampler \
        src/backends/opengl/opengl_globals \
        src/backends/opengl/opengl_shaders \
        src/backends/opengl/opengl_fbo \
        src/backends/opengl/opengl_context \
        src/backends/opengl/opengl_sync \
        src/backends/opengl/opengl_pixel_utils \
        src/backends/opengl/opengl_drawing \
        src/backends/opengl/opengl_backend \
        src/backends/cybergfx/cybergfx_text \
        src/backends/cybergfx/cybergfx_polygon \
        src/backends/opengl/opengl_text

ROOT_FILES := \
        zunegfx_init

# Combine all source files
FILES := \
        $(CORE_FILES)                   \
        $(TEXTURE_FILES)                \
        $(DRAWINGBOARD_FILES)           \
        $(CLIPPING_FILES)               \
        $(BATCHING_FILES)               \
        $(DRAWING_FILES)                \
        $(TEXT_FILES)                    \
        $(RECTANGLE_FILES)              \
        $(ANTIALIASING_FILES)           \
        $(BACKEND_FILES)                \
        $(ROOT_FILES)

#MM- workbench-libs-zunegfx : linklibs
#MM- workbench-libs-zunegfx-kobj : linklibs

#MM- workbench-libs-zunegfx-includes :    \
#MM      kernel-exec-includes                  \
#MM      includes-copy
#MM- core-linklibs: linklibs-zunegfx

INCLUDE_FILES := $(call WILDCARD, include/*.h)

%copy_includes path=libraries dir=include

%build_module mmake=workbench-libs-zunegfx \
  modname=zunegfx modtype=library \
  files="$(FUNCS) $(FILES)" \
  uselibs="graphics cybergraphics layers GL diskfont"

# Additional build flags for debugging
USER_CPPFLAGS := -DDEBUG=1 -DAROS_LITTLE_ENDIAN=1 -mavx2

# Make sure include headers are found
USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/include
